    "scope_class":  "closed_world",
    "rewrite_policy":  "rewrite_only",
    "release":  {
                    "release_id":  "v0",
                    "release_name":  "Deterministic Execution Alpha",
                    "definition":  "Kolosseum v0 is a closed-world, coach-operable deterministic execution alpha for individual and coach-managed sessions across powerlifting, rugby_union, and general_strength, limited to Phase 1 through Phase 6 and factual runtime execution surfaces only."
                },
    "enforcement":  {
                        "unknown_values_fail_closed":  true,
                        "manifest_grants_engine_behaviour":  false,
                        "manifest_controls_scope_only":  true,
                        "ci_required":  true
                    },
