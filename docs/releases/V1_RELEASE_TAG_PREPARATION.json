{
  "schema_version": "kolosseum.v1_release_tag_preparation.v1.0.0",
  "slice_id": "S-V1-F-04",
  "record_id": "v1_release_tag_preparation",
  "record_title": "V1 Release Tag Preparation",
  "record_state": "preparation_only_not_tagged",
  "candidate_tag": "v1-controlled-launch",
  "authority_boundary": {
    "creates_git_tag": false,
    "pushes_git_tag": false,
    "changes_package_version": false,
    "implements_feature": false,
    "changes_engine_behaviour": false,
    "changes_registry_content": false,
    "changes_acceptance_manifest": false,
    "activates_post_v1_scope": false,
    "creates_external_approval": false
  },
  "required_existing_commands": {
    "release_prepare": "npm.cmd run release:prepare",
    "release_tag": "npm.cmd run release:tag",
    "acceptance_check": "npm.cmd run acceptance:v1:check",
    "full_fast_gate": "npm.cmd run lint:fast"
  },
  "required_pre_tag_order": [
    "clean_repository_state_checked",
    "v1_acceptance_check_passed",
    "release_notes_and_version_docs_checked",
    "full_fast_gate_passed",
    "current_commit_confirmed_on_main",
    "operator_confirms_candidate_tag_name"
  ],
  "tag_block_conditions": [
    "acceptance_check_not_passed",
    "full_fast_gate_not_passed",
    "dirty_working_tree",
    "current_commit_not_intended_main_commit",
    "candidate_tag_already_exists",
    "release_notes_or_version_tag_docs_missing",
    "operator_has_not_confirmed_candidate_tag"
  ],
  "required_proof_commands": [
    "npm.cmd run acceptance:v1:check",
    "node --test test/s_v1_f_04_v1_release_tag_preparation.test.mjs",
    "node ci/guards/s_v1_f_04_v1_release_tag_preparation_guard.mjs",
    "node ci/guards/s_v1_09_failure_token_closure_guard.mjs",
    "node ci/guards/guards_entrypoint_coverage_guard.mjs",
    "npm.cmd run lint:fast"
  ],
  "required_release_documents": [
    "docs/releases/V1_RELEASE_NOTES.md",
    "docs/releases/V1_VERSION_AND_TAG.md",
    "docs/releases/V1_RELEASE_TAG_PREPARATION.md"
  ],
  "unsupported_claims_must_not_state_or_imply": [
    "safety",
    "suitability",
    "effectiveness",
    "external approval",
    "certification",
    "athlete clearance",
    "coach clearance",
    "training approval",
    "outcome guarantee",
    "broad rollout permission",
    "enterprise launch permission"
  ],
  "completion_rule": {
    "record_exists": true,
    "guard_passes": true,
    "test_passes": true,
    "generated_indexes_refreshed_by_owning_generators": true,
    "acceptance_check_passes": true,
    "full_fast_gate_passes": true,
    "pr_merged": true,
    "git_tag_created_by_this_slice": false
  }
}
