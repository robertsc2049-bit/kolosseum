# Copy to .env next to docker-compose.prod.yml on the server and fill in.
# Never commit the filled-in copy.

# Required
KOLOSSEUM_DOMAIN=app.example.com
KOLOSSEUM_PUBLIC_APP_URL=https://app.example.com
# A long random password: openssl rand -hex 24
POSTGRES_PASSWORD=

# Web Push (phone notifications): node scripts/generate_vapid_keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email via Resend (https://resend.com). Sign-up verification and
# password-reset codes are emailed from KOLOSSEUM_EMAIL_FROM, an address on a
# domain verified in Resend (e.g. Kolosseum <no-reply@mail.kolosseum.tools>).
# Without a key no codes are emailed, so nobody can reset a forgotten password.
# The support-alert lines email you when a user reports a problem.
RESEND_API_KEY=
KOLOSSEUM_EMAIL_FROM=
KOLOSSEUM_SUPPORT_ALERT_EMAIL_TO=
KOLOSSEUM_SUPPORT_ALERT_EMAIL_FROM=

# Billing (Stripe) - optional for a free beta.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KOLOSSEUM_CONTROLLED_LAUNCH_PLAN_ID=
KOLOSSEUM_CONTROLLED_LAUNCH_PRICE_ID=
KOLOSSEUM_CONTROLLED_LAUNCH_SEAT_LIMIT=

# Kolosseum programme authors (comma-separated coach emails).
KOLOSSEUM_PROGRAMME_AUTHORS=

# Days of nightly backups to keep on the server.
BACKUP_KEEP_DAYS=14
