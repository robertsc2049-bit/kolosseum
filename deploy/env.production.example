# Copy to .env next to docker-compose.prod.yml on the server and fill in.
# Never commit the filled-in copy.

# Required
KOLOSSEUM_DOMAIN=app.example.com
KOLOSSEUM_PUBLIC_APP_URL=https://app.example.com
# A long random password: openssl rand -hex 24
POSTGRES_PASSWORD=

# Web Push (phone notifications): node scripts/generate_vapid_keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email via Resend (https://resend.com). Sign-up verification and
# password-reset codes are emailed from KOLOSSEUM_EMAIL_FROM, an address on a
# domain verified in Resend (e.g. Kolosseum <no-reply@mail.kolosseum.tools>).
# Without a key no codes are emailed, so nobody can reset a forgotten password.
# The support-alert lines email you when a user reports a problem, and when
# backups stop working (the FROM falls back to KOLOSSEUM_EMAIL_FROM).
RESEND_API_KEY=
KOLOSSEUM_EMAIL_FROM=
KOLOSSEUM_SUPPORT_ALERT_EMAIL_TO=
KOLOSSEUM_SUPPORT_ALERT_EMAIL_FROM=

# Billing (Stripe) - optional for a free beta.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
KOLOSSEUM_CONTROLLED_LAUNCH_PLAN_ID=
KOLOSSEUM_CONTROLLED_LAUNCH_PRICE_ID=
KOLOSSEUM_CONTROLLED_LAUNCH_SEAT_LIMIT=

# Kolosseum programme authors (comma-separated coach emails).
KOLOSSEUM_PROGRAMME_AUTHORS=

# Days of nightly backups to keep (on the server, and off it).
BACKUP_KEEP_DAYS=14

# Off-server copies of the backups, in IONOS S3 Object Storage (or any
# S3-compatible storage). Off until the bucket and key are set. Create the
# bucket and an access key in the IONOS console (docs/ops/IONOS_VPS_DEPLOYMENT.md).
OFFSITE_BACKUP_BUCKET=
OFFSITE_BACKUP_ACCESS_KEY=
OFFSITE_BACKUP_SECRET_KEY=
# The bucket's region: Frankfurt is s3-eu-central-1.ionoscloud.com / de,
# Berlin s3-eu-central-2.ionoscloud.com / eu-central-2.
OFFSITE_BACKUP_ENDPOINT=s3-eu-central-1.ionoscloud.com
OFFSITE_BACKUP_REGION=de
# IONOS, or another rclone S3 provider name (e.g. Other).
OFFSITE_BACKUP_PROVIDER=IONOS
# Encrypts each backup on this server before it is copied off it, so the
# storage provider only holds ciphertext. At least 20 characters - a few
# random words. Keep a copy in a password manager: without it the off-server
# backups cannot be restored.
OFFSITE_BACKUP_PASSPHRASE=
