{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolosseum://registries/program.registry.schema.json",
  "title": "program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "entries"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "const": "program"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "activity_id",
          "template_id",
          "exercise_eligibility"
        ],
        "properties": {
          "activity_id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "powerlifting",
              "general_strength",
              "rugby_union",
              "strongman",
              "hyrox",
              "crossfit",
              "football_soccer",
              "netball",
              "basketball",
              "rugby_sevens",
              "field_hockey",
              "ice_hockey",
              "volleyball",
              "cricket",
              "american_football",
              "athletics",
              "swimming",
              "olympic_weightlifting",
              "cycling",
              "rowing",
              "kayaking",
              "boxing",
              "wrestling",
              "judo",
              "brazilian_jiu_jitsu",
              "muay_thai",
              "mma",
              "tennis",
              "triathlon",
              "rugby_league",
              "street_lifting"
            ]
          },
          "template_id": {
            "type": "string",
            "minLength": 1
          },
          "exercise_eligibility": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "item_prescriptions": {
            "$ref": "#/$defs/item_prescriptions"
          },
          "level_variants": {
            "$ref": "#/$defs/level_variants"
          },
          "event_variants": {
            "type": "object",
            "additionalProperties": false,
            "minProperties": 1,
            "properties": {
              "bench_only": {
                "$ref": "#/$defs/event_variant"
              },
              "deadlift_only": {
                "$ref": "#/$defs/event_variant"
              },
              "push_pull": {
                "$ref": "#/$defs/event_variant"
              },
              "squat_only": {
                "$ref": "#/$defs/event_variant"
              }
            }
          }
        }
      },
      "minItems": 1
    }
  },
  "$defs": {
    "item_prescriptions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sets",
          "reps",
          "intensity",
          "rest_seconds"
        ],
        "properties": {
          "sets": {
            "type": "integer",
            "minimum": 1
          },
          "reps": {
            "type": "integer",
            "minimum": 1
          },
          "rest_seconds": {
            "type": "integer",
            "minimum": 0
          },
          "intensity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "percent_1rm",
                  "rpe",
                  "bodyweight"
                ]
              },
              "value": {
                "type": "number"
              }
            }
          },
          "group": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "group_id",
              "group_type"
            ],
            "properties": {
              "group_id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9_]*$"
              },
              "group_type": {
                "type": "string",
                "enum": [
                  "superset",
                  "circuit",
                  "complex",
                  "amrap",
                  "emom",
                  "for_time"
                ]
              },
              "time_cap_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "round_seconds": {
                "type": "integer",
                "minimum": 1
              },
              "total_rounds": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "distance_m": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "duration_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600
          }
        }
      }
    },
    "level_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercise_eligibility",
        "item_prescriptions"
      ],
      "properties": {
        "exercise_eligibility": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "item_prescriptions": {
          "$ref": "#/$defs/item_prescriptions"
        }
      }
    },
    "level_variants": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "beginner": {
          "$ref": "#/$defs/level_variant"
        },
        "pro": {
          "$ref": "#/$defs/level_variant"
        }
      }
    },
    "event_variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "exercise_eligibility",
        "item_prescriptions"
      ],
      "properties": {
        "exercise_eligibility": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "item_prescriptions": {
          "$ref": "#/$defs/item_prescriptions"
        },
        "level_variants": {
          "$ref": "#/$defs/level_variants"
        }
      }
    }
  },
  "x-kolosseum-authority": "compatibility_only",
  "x-kolosseum-canonical-authority": "registries/final_registry_schema_manifest.json"
}
