{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolosseum://registries/program.registry.schema.json",
  "title": "program",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "entries"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "const": "program"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "activity_id",
          "template_id",
          "exercise_eligibility"
        ],
        "properties": {
          "activity_id": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "powerlifting",
              "general_strength",
              "rugby_union"
            ]
          },
          "template_id": {
            "type": "string",
            "minLength": 1
          },
          "exercise_eligibility": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minItems": 1
    }
  },
  "x-kolosseum-authority": "compatibility_only",
  "x-kolosseum-canonical-authority": "registries/final_registry_schema_manifest.json"
}
