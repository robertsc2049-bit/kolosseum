{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolosseum://registries/canonical/copy_registry.registry.schema.json",
  "title": "copy_registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "entries"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "const": "copy_registry"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "copy_id",
          "copy_category",
          "allowed_phrase",
          "forbidden_phrase_references",
          "supported_surface",
          "activity_applicability",
          "status"
        ],
        "properties": {
          "copy_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "copy_category": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "allowed_phrase": {
            "type": "string",
            "minLength": 1
          },
          "forbidden_phrase_references": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            "uniqueItems": true
          },
          "supported_surface": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "activity_applicability": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "powerlifting",
                "general_strength",
                "rugby_union"
              ]
            },
            "uniqueItems": true
          },
          "status": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          }
        }
      }
    }
  }
}
