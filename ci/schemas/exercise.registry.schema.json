{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolosseum://registries/exercise.registry.schema.json",
  "title": "exercise",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "entries"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "const": "exercise"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exercise_id",
          "movement_pattern_id",
          "stimulus_intent",
          "rom",
          "stability",
          "equipment_tier",
          "difficulty_tier",
          "joint_stress_tags",
          "tempo_capability",
          "instruction_short_text",
          "instruction_detail_text",
          "coaching_cues",
          "common_faults",
          "fast_execution",
          "equipment_requirements",
          "equipment_alternatives",
          "primary_activity_applicability",
          "secondary_activity_applicability",
          "display_label",
          "contraindication_or_exclusion_tags",
          "substitution_eligibility",
          "template_eligibility",
          "copy_legal_boundary_flags"
        ],
        "properties": {
          "exercise_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "movement_pattern_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "stimulus_intent": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "rom": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "stability": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "equipment_tier": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "TIER_1",
              "TIER_2",
              "TIER_3",
              "TIER_4"
            ]
          },
          "difficulty_tier": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "joint_stress_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "tempo_capability": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "instruction_short_text": {
            "type": "string",
            "minLength": 1
          },
          "instruction_detail_text": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "coaching_cues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "common_faults": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "fast_execution": {
            "type": "boolean"
          },
          "equipment_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          },
          "equipment_alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            "uniqueItems": true
          },
          "primary_activity_applicability": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "powerlifting",
              "general_strength",
              "rugby_union",
              "strongman"
            ]
          },
          "secondary_activity_applicability": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "enum": [
                "powerlifting",
                "general_strength",
                "rugby_union"
              ]
            },
            "uniqueItems": true
          },
          "reference_media": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "video_url",
              "thumbnail_url",
              "source",
              "source_reference",
              "license_status",
              "commercial_use_status",
              "manual_review_status",
              "legal_review_status",
              "copy_boundary_flags"
            ],
            "properties": {
              "video_url": {
                "type": "string",
                "minLength": 1
              },
              "thumbnail_url": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "minLength": 1,
                "enum": [
                  "founder_original",
                  "licensed_source",
                  "canonical_project_document"
                ]
              },
              "source_reference": {
                "type": "string",
                "minLength": 1
              },
              "license_status": {
                "type": "string",
                "minLength": 1
              },
              "commercial_use_status": {
                "type": "string",
                "minLength": 1
              },
              "manual_review_status": {
                "type": "string",
                "minLength": 1
              },
              "legal_review_status": {
                "type": "string",
                "minLength": 1
              },
              "copy_boundary_flags": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9_.-]*$"
                },
                "uniqueItems": true
              }
            }
          },
          "display_label": {
            "type": "string",
            "minLength": 1
          },
          "contraindication_or_exclusion_tags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            "uniqueItems": true
          },
          "substitution_eligibility": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "eligible",
              "restricted"
            ]
          },
          "template_eligibility": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "eligible",
              "not_eligible"
            ]
          },
          "copy_legal_boundary_flags": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9_.-]*$"
            },
            "minItems": 1,
            "uniqueItems": true
          }
        }
      },
      "minProperties": 1
    }
  },
  "x-kolosseum-authority": "compatibility_only",
  "x-kolosseum-canonical-authority": "registries/final_registry_schema_manifest.json"
}
