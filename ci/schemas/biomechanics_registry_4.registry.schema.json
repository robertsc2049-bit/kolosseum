{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolosseum://registries/canonical/biomechanics_registry_4.registry.schema.json",
  "title": "biomechanics_registry_4",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "entries"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "const": "biomechanics_registry_4"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "biomechanics_id",
          "category",
          "display_name",
          "description"
        ],
        "properties": {
          "biomechanics_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "category": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "display_name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
