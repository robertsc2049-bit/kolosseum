{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolosseum://registries/exercise.registry.schema.json",
  "title": "Exercise Registry Schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "entries"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "const": "exercise"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exercise_id",
          "pattern",
          "stimulus_intent",
          "rom",
          "stability",
          "equipment",
          "equipment_tags",
          "equipment_tier",
          "difficulty_tier",
          "joint_stress_tags",
          "instruction",
          "fast_execution",
          "primary_activity_applicability",
          "secondary_activity_applicability"
        ],
        "properties": {
          "exercise_id": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "stimulus_intent": {
            "type": "string",
            "minLength": 1
          },
          "rom": {
            "type": "string",
            "minLength": 1
          },
          "stability": {
            "type": "string",
            "minLength": 1
          },
          "equipment": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "equipment_tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "barbell",
                "dumbbell",
                "bodyweight",
                "machine",
                "strongman",
                "kettlebell"
              ]
            }
          },
          "equipment_tier": {
            "type": "string",
            "minLength": 1
          },
          "difficulty_tier": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "joint_stress_tags": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "tempo_capability": {
            "type": "string",
            "enum": [
              "none",
              "paused",
              "tempo",
              "paused_and_tempo"
            ]
          },
          "instruction": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "short"
            ],
            "properties": {
              "short": {
                "type": "string",
                "minLength": 1
              },
              "detailed": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "fast_execution": {
            "type": "boolean"
          },
          "equipment_requirements": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "equipment_alternatives": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "primary_activity_applicability": {
            "type": "string",
            "minLength": 1
          },
          "secondary_activity_applicability": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "coaching_cues": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "common_faults": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reference_media": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "video_url",
              "source"
            ],
            "properties": {
              "video_url": {
                "type": "string",
                "minLength": 1
              },
              "thumbnail_url": {
                "type": "string",
                "minLength": 1
              },
              "source": {
                "type": "string",
                "enum": [
                  "coach_entered",
                  "admin_entered"
                ]
              }
            }
          }
        }
      }
    }
  }
}
