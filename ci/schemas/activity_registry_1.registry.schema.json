{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolosseum://registries/canonical/activity_registry_1.registry.schema.json",
  "title": "activity_registry_1",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "version", "entries"],
  "properties": {
    "registry_id": {"type": "string", "const": "activity_registry_1"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["activity_id", "display_label", "allowed_movement_patterns", "allowed_exercise_families", "allowed_equipment_classes", "allowed_programme_template_types", "allowed_substitution_scope", "excluded_claim_language", "copy_legal_boundary_notes"],
        "properties": {
          "activity_id": {"type": "string", "enum": ["powerlifting", "general_strength", "rugby_union"]},
          "display_label": {"type": "string", "minLength": 1},
          "allowed_movement_patterns": {
            "type": "array",
            "items": {"type": "string", "enum": ["squat", "hinge", "single_leg_squat", "single_leg_hinge", "knee_extension_isolation", "knee_flexion_isolation", "hip_abduction_isolation", "hip_adduction_isolation", "hip_extension_isolation", "hip_flexion_isolation", "calf_raise", "tibialis_raise", "horizontal_push", "incline_push", "decline_push", "vertical_push", "angled_push", "horizontal_pull", "vertical_pull", "scapular_retraction", "scapular_protraction", "scapular_upward_rotation", "scapular_depression", "shoulder_external_rotation", "shoulder_internal_rotation", "shoulder_abduction_isolation", "shoulder_horizontal_abduction_isolation", "elbow_flexion_isolation", "elbow_extension_isolation", "forearm_flexion_isolation", "forearm_extension_isolation", "grip_crush", "grip_support", "carry_bilateral", "carry_unilateral", "core_anti_extension", "core_anti_rotation", "core_anti_lateral_flexion", "trunk_flexion", "trunk_extension", "rotation", "locomotion_walk", "locomotion_run", "locomotion_crawl", "jump_vertical", "jump_horizontal", "sprint_acceleration", "sprint_max_velocity", "deceleration", "change_of_direction", "throw_slam", "conditioning_cyclical", "conditioning_row", "conditioning_sled"]},
            "minItems": 54,
            "maxItems": 54,
            "uniqueItems": true
          },
          "allowed_exercise_families": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_.-]*$"}, "minItems": 1, "uniqueItems": true},
          "allowed_equipment_classes": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_.-]*$"}, "minItems": 1, "uniqueItems": true},
          "allowed_programme_template_types": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_.-]*$"}, "minItems": 1, "uniqueItems": true},
          "allowed_substitution_scope": {"type": "array", "items": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9_.-]*$"}, "minItems": 1, "uniqueItems": true},
          "excluded_claim_language": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
          "copy_legal_boundary_notes": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
