{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolosseum://registries/canonical/sport_metric_registry_1c.registry.schema.json",
  "title": "sport_metric_registry_1c",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "entries"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "const": "sport_metric_registry_1c"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sport_metric_id",
          "activity_id",
          "sport_subdivision_id",
          "display_label",
          "metric_kind",
          "unit",
          "value_type",
          "copy_boundary_notes"
        ],
        "properties": {
          "sport_metric_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "activity_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "sport_subdivision_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "display_label": {
            "type": "string",
            "minLength": 1
          },
          "metric_kind": {
            "type": "string",
            "minLength": 1
          },
          "unit": {
            "type": "string",
            "minLength": 1
          },
          "value_type": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "number",
              "integer",
              "string",
              "boolean",
              "enum"
            ]
          },
          "copy_boundary_notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
