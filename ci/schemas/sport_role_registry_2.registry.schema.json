{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolosseum://registries/canonical/sport_role_registry_2.registry.schema.json",
  "title": "sport_role_registry_2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "entries"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "const": "sport_role_registry_2"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sport_role_id",
          "activity_id",
          "sport_subdivision_id",
          "display_label",
          "context_type",
          "copy_boundary_notes"
        ],
        "properties": {
          "sport_role_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "activity_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "sport_subdivision_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "display_label": {
            "type": "string",
            "minLength": 1
          },
          "context_type": {
            "type": "string",
            "minLength": 1
          },
          "copy_boundary_notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
