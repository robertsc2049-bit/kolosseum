{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolosseum://registries/canonical/event_metric_registry_1d.registry.schema.json",
  "title": "event_metric_registry_1d",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "entries"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "const": "event_metric_registry_1d"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_metric_id",
          "activity_id",
          "sport_subdivision_id",
          "event_type",
          "value_type",
          "allowed_values",
          "scope",
          "required",
          "notes"
        ],
        "properties": {
          "event_metric_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "activity_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "sport_subdivision_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "event_type": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "value_type": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "string",
              "integer",
              "boolean",
              "enum"
            ]
          },
          "allowed_values": {
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              },
              {
                "type": "null"
              }
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "individual",
              "team",
              "unit",
              "organisation"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "notes": {
            "type": "null"
          }
        }
      }
    }
  }
}
