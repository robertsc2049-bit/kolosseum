{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolosseum://registries/threshold_marker.registry.schema.json",
  "title": "Threshold Marker Registry Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "version", "entries"],
  "properties": {
    "registry_id": { "type": "string", "const": "threshold_marker" },
    "version": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "threshold_marker_id",
          "id",
          "sport_metric_id",
          "activity_id",
          "threshold_operator",
          "threshold_value",
          "threshold_unit",
          "threshold_source",
          "marker_status_allowed_values",
          "copy_boundary_notes"
        ],
        "properties": {
          "threshold_marker_id": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "sport_metric_id": { "type": "string", "minLength": 1 },
          "activity_id": { "type": "string", "minLength": 1 },
          "threshold_operator": { "type": "string", "minLength": 1 },
          "threshold_value": { "type": "number" },
          "threshold_unit": { "type": "string", "minLength": 1 },
          "threshold_source": { "type": "string", "minLength": 1 },
          "marker_status_allowed_values": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "copy_boundary_notes": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
