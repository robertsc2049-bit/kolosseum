{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolosseum://registries/exercise_activity_applicability.registry.schema.json",
  "title": "exercise_activity_applicability",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_id",
    "version",
    "entries"
  ],
  "properties": {
    "registry_id": {
      "type": "string",
      "const": "exercise_activity_applicability"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "entries": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "applicability_id",
          "exercise_id",
          "activity_id",
          "activity_context",
          "applicability_state",
          "conditions",
          "tier_cap",
          "template_applicability",
          "substitution_applicability",
          "copy_legal_boundary_notes"
        ],
        "properties": {
          "applicability_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "exercise_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "activity_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9_.-]*$"
          },
          "activity_context": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "training",
              "testing",
              "competition"
            ]
          },
          "applicability_state": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "allowed",
              "conditional",
              "prohibited"
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "tier_cap": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 4
              },
              {
                "type": "null"
              }
            ]
          },
          "template_applicability": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "eligible",
              "not_eligible"
            ]
          },
          "substitution_applicability": {
            "type": "string",
            "minLength": 1,
            "enum": [
              "eligible",
              "not_eligible"
            ]
          },
          "copy_legal_boundary_notes": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "minProperties": 1
    }
  },
  "x-kolosseum-authority": "compatibility_only",
  "x-kolosseum-canonical-authority": "registries/final_registry_schema_manifest.json"
}
