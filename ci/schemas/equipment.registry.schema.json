{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kolosseum://registries/equipment.registry.schema.json",
  "title": "Equipment Registry Schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_id", "version", "entries"],
  "properties": {
    "registry_id": { "type": "string", "const": "equipment" },
    "version": { "type": "string", "minLength": 1 },
    "entries": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "equipment_id",
          "id",
          "display_label",
          "equipment_class",
          "activity_applicability",
          "movement_pattern_applicability",
          "substitution_relevance",
          "template_relevance",
          "low_equipment_alternative_relevance",
          "copy_legal_boundary_notes"
        ],
        "properties": {
          "equipment_id": { "type": "string", "minLength": 1 },
          "id": { "type": "string", "minLength": 1 },
          "display_label": { "type": "string", "minLength": 1 },
          "equipment_class": { "type": "string", "minLength": 1 },
          "activity_applicability": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "movement_pattern_applicability": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "substitution_relevance": { "type": "string", "minLength": 1 },
          "template_relevance": { "type": "string", "minLength": 1 },
          "low_equipment_alternative_relevance": { "type": "string", "minLength": 1 },
          "copy_legal_boundary_notes": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
