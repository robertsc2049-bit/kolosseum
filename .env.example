DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/kolosseum
PORT=3000

# Optional: interface the server binds to (src/main.ts). Defaults to
# 127.0.0.1 (loopback-only) for bare-metal/local-dev. Containerised
# deployments must set this to 0.0.0.0 - see docker-compose.yml - since a
# container's loopback interface is not reachable through its published port.
HOST=

# Real Stripe billing for individual-coach subscriptions (FULL-UI-08). Use a
# test-mode secret key (sk_test_...) for local development. STRIPE_WEBHOOK_SECRET
# is the signing secret for the /webhooks/stripe endpoint (from the Stripe
# Dashboard or `stripe listen` when using the Stripe CLI locally).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Existing controlled-launch product config the checkout/webhook path reads.
KOLOSSEUM_CONTROLLED_LAUNCH_PLAN_ID=
KOLOSSEUM_CONTROLLED_LAUNCH_PRICE_ID=
KOLOSSEUM_CONTROLLED_LAUNCH_SEAT_LIMIT=
KOLOSSEUM_PUBLIC_APP_URL=
